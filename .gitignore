# Secrets — never commit these
.env
.env.*
!.env.example
*.pem
*.key
*credentials*.json
# Google OAuth client downloads (client_secret_<id>.apps.googleusercontent.com.json)
client_secret*.json
*service-account*.json
*serviceaccount*.json
# No trailing slash, so a symlink to the secrets folder (from a jj workspace) is ignored too, not just the folder.
secrets
.secrets

# Dependencies / build output
# No trailing slash: a jj workspace's node_modules is a symlink to the main checkout's, and `node_modules/` only matches a directory.
node_modules
.next/
out/
dist/
build/
*.tsbuildinfo
next-env.d.ts

# Vercel
.vercel

# OS / editor
.DS_Store

# Statement-ingestion pipeline: run logs and the local processed-message-id cache
/logs/
/state/

# PDFs: real bank/card statements and design exports carry personal financial data.
# Only synthetic test fixtures are committed.
*.pdf
!src/lib/pdf/__fixtures__/*.pdf
